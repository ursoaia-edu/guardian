# PREREQUISITE, before the first "guardian-server migrate" against a fresh
# production database: 00001_init.sql runs "GRANT ... TO guardian_app", so
# that role (and the owner role below) must already exist.
#
# Using docker-compose.yml in this directory? It creates both roles for you
# (db-init/01-roles.sh plus the postgres image's own POSTGRES_USER
# bootstrap) — just fill in POSTGRES_OWNER_PASSWORD and GUARDIAN_APP_PASSWORD
# below so they match DATABASE_URL/MIGRATE_DATABASE_URL.
#
# Deploying guardian-server directly against a Postgres you manage yourself
# (install.sh)? Nothing creates the roles for you — run this once, by hand,
# as a superuser, before the first migrate (see specs/server.md's
# "Production role prerequisites"):
#
#   CREATE ROLE guardian_owner LOGIN PASSWORD 'CHANGE_ME';
#   ALTER DATABASE guardian OWNER TO guardian_owner;
#   CREATE ROLE guardian_app LOGIN PASSWORD 'CHANGE_ME';
#   GRANT CONNECT ON DATABASE guardian TO guardian_app;
#   GRANT USAGE ON SCHEMA public TO guardian_app;
#
# Either way, guardian_owner must then be the SAME role for every migration
# run, forever: ALTER DEFAULT PRIVILEGES records the default grant for the
# role that ran it, not for the schema, so a later migration run under a
# different owner role silently stops granting guardian_app anything on the
# tables it creates.

# Application connection. This role must NOT own the tables and must NOT have
# BYPASSRLS: row-level security is what stops one customer reading another's data.
DATABASE_URL=postgres://guardian_app:CHANGE_ME@localhost:5432/guardian

# Owner connection, used only by "guardian-server migrate".
MIGRATE_DATABASE_URL=postgres://guardian_owner:CHANGE_ME@localhost:5432/guardian

# docker-compose.yml only: passwords the postgres container bootstraps its
# two roles with. Must equal the passwords embedded in MIGRATE_DATABASE_URL
# and DATABASE_URL above. Unused (and harmless) if you are not using
# docker-compose.yml.
POSTGRES_OWNER_PASSWORD=CHANGE_ME
GUARDIAN_APP_PASSWORD=CHANGE_ME

# Comma-separated origins allowed to send credentialed requests.
CABINET_ORIGIN=https://app.example.com

SERVER_ADDRESS=0.0.0.0:8080
