# PREREQUISITE, before the first "guardian-server migrate" against a fresh
# production database: 00001_init.sql runs "GRANT ... TO guardian_app", so
# that role (and the owner role below) must already exist.
#
# Using docker-compose.yml in this directory? It creates both roles for you
# (db-init/01-roles.sh plus the postgres image's own POSTGRES_USER
# bootstrap) — just fill in POSTGRES_OWNER_PASSWORD and GUARDIAN_APP_PASSWORD
# below so they match DATABASE_URL/MIGRATE_DATABASE_URL.
#
# Deploying guardian-server directly against a Postgres you manage yourself
# (install.sh)? Nothing creates the roles for you — run this once, by hand,
# as a superuser, before the first migrate (see specs/server.md's
# "Production role prerequisites"):
#
#   CREATE ROLE guardian_owner LOGIN PASSWORD 'CHANGE_ME';
#   ALTER DATABASE guardian OWNER TO guardian_owner;
#   CREATE ROLE guardian_app LOGIN PASSWORD 'CHANGE_ME';
#   GRANT CONNECT ON DATABASE guardian TO guardian_app;
#   GRANT USAGE ON SCHEMA public TO guardian_app;
#
# Either way, guardian_owner must then be the SAME role for every migration
# run, forever: ALTER DEFAULT PRIVILEGES records the default grant for the
# role that ran it, not for the schema, so a later migration run under a
# different owner role silently stops granting guardian_app anything on the
# tables it creates.

# Application connection. This role must NOT own the tables and must NOT have
# BYPASSRLS: row-level security is what stops one customer reading another's data.
DATABASE_URL=postgres://guardian_app:CHANGE_ME@localhost:5432/guardian

# Owner connection, used only by "guardian-server migrate".
MIGRATE_DATABASE_URL=postgres://guardian_owner:CHANGE_ME@localhost:5432/guardian

# docker-compose.yml only: passwords the postgres container bootstraps its
# two roles with. Must equal the passwords embedded in MIGRATE_DATABASE_URL
# and DATABASE_URL above. Unused (and harmless) if you are not using
# docker-compose.yml.
POSTGRES_OWNER_PASSWORD=CHANGE_ME
GUARDIAN_APP_PASSWORD=CHANGE_ME

# Comma-separated origins allowed to send credentialed requests. With
# docker-compose.yml this is https://<GUARDIAN_DOMAIN>.
CABINET_ORIGIN=https://guardian.example.com

SERVER_ADDRESS=0.0.0.0:8080

# Number of reverse-proxy hops between the public internet and the server.
# 0 (nothing in front; the TCP peer is the client) is right for a bare
# install.sh deployment and is the only safe value when no proxy exists:
# with a proxy count set and no proxy present, any client can write its own
# X-Forwarded-For and pick its own rate-limit bucket. Put Caddy or nginx in
# front yourself and this becomes 1. docker-compose.yml overrides it to 1
# for its own Caddy regardless of what is written here.
TRUSTED_PROXIES=0

# docker-compose.yml only: the DNS name Caddy serves on and fetches a
# Let's Encrypt certificate for. Ports 80 and 443 must reach this host.
GUARDIAN_DOMAIN=guardian.example.com

# --- Mail (SendGrid over SMTP) -------------------------------------------
# The username is the LITERAL STRING "apikey" — not your email, not a name.
# Getting this wrong costs an hour of "authentication failed".
# Percent-encode any @ : or / inside the key itself.
# The API key is scoped to "Mail Send" and nothing else.
SMTP_URL=smtp://apikey:SG.replace-me@smtp.sendgrid.net:587

# The From address, which MUST be verified in SendGrid or nothing is accepted.
MAIL_FROM=Guardian <noreply@example.com>

# Development only: print mail instead of sending it. Leave unset in
# production. The server refuses to start when neither this nor SMTP_URL is
# set, on purpose — a server that boots with mail silently disabled produces
# customers who cannot reset their password.
# MAIL_TRANSPORT=log

# Two prerequisites that are not code and decide whether mail arrives at all:
#
#  1. Domain authentication — the CNAME records SendGrid issues for SPF and
#     DKIM. Without them mail from a fresh domain lands in spam, and a reset
#     link in a spam folder is indistinguishable from a broken product. Single
#     Sender Verification is enough to SEND and not enough to be DELIVERED.
#  2. A plan that covers the volume. The free tier is 100 messages a day.
