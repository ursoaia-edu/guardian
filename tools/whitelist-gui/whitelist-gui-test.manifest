<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifest for the TEST binary only.

  walk needs Common Controls 6.0 to create its widgets: without it window
  construction dies with "TTM_ADDTOOL failed". But the release manifest also
  requests requireAdministrator, and an elevated test binary cannot be launched
  by "go test" at all. So the test build gets the same controls dependency with
  asInvoker instead.

  Generated into a .syso by test.ps1, which deletes it again afterwards.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      version="1.0.0.0"
      processorArchitecture="*"
      name="ProcSentinel.WhitelistEditor.Test"
      type="win32"/>
  <description>ProcSentinel whitelist editor test binary</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
